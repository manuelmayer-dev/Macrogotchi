{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.suchbyte.macrogotchi",
  "name": "Macrogotchi",
  "version": "1.0.2",
  "description": "A virtual pet living on your deck.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/Macrogotchi.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/Macrogotchi.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "linux-x64": {
      "executable": "runtimes/linux-x64/Macrogotchi.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "Manuel Mayer"
  },
  "license": "MIT",
  "repository": "https://github.com/manuelmayer-dev/Macrogotchi",
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.7"
  }
}